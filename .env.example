# Copy to .env and fill in. Keep .env private (it is in .gitignore and .dockerignore).
# Account passwords: 12+ characters with letters and digits. Used only when the database has no users yet.
SKYCONTROL_CONTROLLER_PASSWORD=
SKYCONTROL_SUPERVISOR_PASSWORD=

# Optional OpenSky API client credentials for live capture (Data & provenance page).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Local run only (Docker sets these itself). Loopback by default.
SKYCONTROL_HOST=127.0.0.1
SKYCONTROL_PORT=5000
